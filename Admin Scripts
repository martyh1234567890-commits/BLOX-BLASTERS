		local parts = string.split(message, " ")
		if #parts >= 3 and parts[1] == "/tp" then
			local playerName = parts[2]
			local partName = parts[3]
			local isAdmin = table.find(adminUserIds, player.UserId)
			if isAdmin then
				teleportPlayerToPart(player, playerName, partName)
			else
				print("You are not authorized to use this command.")
			end
		end
	end)
end)
